# Copy this file to ".env" and fill in your own keys.
# The .env file is in .gitignore, so it is never pushed to GitHub.

# Which LLM the agent uses ("provider:model", the PydanticAI way of writing it)
SCOUT_MODEL=groq:openai/gpt-oss-120b

# Key for the LLM (from https://console.groq.com/keys)
GROQ_API_KEY=

# Key for the paper search (from https://openalex.org/settings/api)
OPENALEX_API_KEY=
